<Window x:Class="DropletScreenmate.Skin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DropletScreenmate"
        mc:Ignorable="d"
        Title="Options" WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Height="210" Width="210" Closed="Window_Closed" Icon="/icon.ico">
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#FF303031"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Width="210" HorizontalAlignment="Center" Height="194">
        <ComboBox VerticalAlignment="Top" Text="Choose..." x:Name="skinDir" Margin="16,35,16,0" IsEditable="True" IsReadOnly="True" Height="24"/>
        <Button Style="{StaticResource ModernButton}" Margin="16,152,16,0" VerticalAlignment="Top" Padding="0,0,0,2" x:Name="btnOK" Height="24" Content="OK" Click="BtnOK_Click" BorderBrush="#FFBFC0C5" IsDefault="True"/>
        <Label VerticalAlignment="Top" Padding="0,0,0,0" Margin="16,74,0,0" HorizontalAlignment="Left" Content="Config"/>
        <TextBox x:Name="velocityNo" TextAlignment="Center" Width="84" VerticalAlignment="Top" Text="60" TextWrapping="Wrap" Padding="0,1,10,0" Margin="16,95,0,0" Height="21" HorizontalAlignment="Left"/>
        <TextBox x:Name="stepsizeNo" TextAlignment="Center" Width="84" VerticalAlignment="Top" Text="3.0" TextWrapping="Wrap" Padding="0,1,10,0" Margin="110,95,0,0" Height="21" HorizontalAlignment="Left"/>
        <Label VerticalAlignment="Top" Padding="0,0,0,0" Margin="16,14,0,0" HorizontalAlignment="Left" Content="Skin"/>
        <Label VerticalAlignment="Top" Padding="0,0,0,1" Margin="16,122,0,0" HorizontalAlignment="Left" Content="Velocity" Width="84" Foreground="#FFA5A5A5" HorizontalContentAlignment="Center" FontSize="10"/>
        <Label VerticalAlignment="Top" Padding="0,0,0,1" Margin="110,122,0,0" HorizontalAlignment="Left" Content="Step Size" Width="84" Foreground="#FFA5A5A5" HorizontalContentAlignment="Center" FontSize="10"/>
        <Button FontSize="6" Padding="0,-1,0,0" Content="▲" Click="VelocityUp_Click" Margin="86,95,110,88" Background="White" BorderBrush="#FFABADB3" Foreground="#FFABADB3" />
        <Button FontSize="6" Padding="0,0,0,0" Content="▼" Click="VelocityDown_Click" Margin="86,105,110,78" Background="White" BorderBrush="#FFABADB3" Foreground="#FFABADB3" />
        <Button FontSize="6" Padding="0,-1,0,0" Content="▲" Click="StepsizeUp_Click" Margin="180,95,16,88" Background="White" BorderBrush="#FFABADB3" Foreground="#FFABADB3" />
        <Button FontSize="6" Padding="0,0,0,0" Content="▼" Click="StepsizeDown_Click" Margin="180,105,16,78" Background="White" BorderBrush="#FFABADB3" Foreground="#FFABADB3" />
    </Grid>
</Window>

